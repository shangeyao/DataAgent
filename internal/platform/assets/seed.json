 "knowledge_docs": [
  {
   "id": "83e4b1789306d3d1",
   "workspace_id": "1629dee48cc4e531",
   "title": "数仓分层规范",
   "content": "ODS：原始贴源层，结构与源系统一致，只做同步不做加工（如采集线工具日志、量测文件）。\nDWD：明细层，完成清洗、去重、维度关联，保留业务过程粒度（如晶圆产出明细）。\nDWS：汇总层，按主题聚合的宽表，供分析与看板使用。\nDIM：公共维度层，产品、晶圆厂、客户等一致性维度。\nADS：应用层，面向具体报表与 Agent 消费的结果表。\n命名规则：层级前缀 + 业务域 + 描述，例如 dwd_semi_wafer_out_detail。",
   "source_type": "manual",
   "tags": "规范",
   "scope": "workspace",
   "created_at": "2026-11-10T12:28:05+08:00",
